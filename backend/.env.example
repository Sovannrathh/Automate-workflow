# Copy to .env and fill in real values. Never commit .env.

# --- n8n / Postgres ---
N8N_HOST=localhost
N8N_PROTOCOL=http
WEBHOOK_URL=http://localhost:5678/
TZ=UTC
# Origin of the frontend/editor-ui dev server (`pnpm serve`, port 8080)
N8N_CORS_ALLOW_ORIGIN=http://localhost:8080
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=change-me
# generate with: openssl rand -hex 32
N8N_ENCRYPTION_KEY=change-me

# --- Facebook App / webhook (facebook.yaml) ---
FB_APP_ID=
FB_APP_SECRET=
FB_VERIFY_TOKEN=change-me
FB_PAGE_ACCESS_TOKEN=
FB_GRAPH_API_VERSION=v21.0
